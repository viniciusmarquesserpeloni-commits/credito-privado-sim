{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stlite-site",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "scripts/build_site.py",
        "--serve",
        "8790"
      ],
      "port": 8790
    },
    {
      "name": "streamlit-local",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app/app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8502"
      ],
      "port": 8502
    }
  ]
}